#: invenio_banners/administration/banners.py:54
msgid ""
"Date/time to make the banner active. Input format: yyyy-mm-dd hh:mm:ss. Set "
"to future date/time to delay the banner. Note: specify time in UTC time "
"standard."
msgstr ""

#: invenio_banners/administration/banners.py:59
#: invenio_banners/administration/banners.py:70
